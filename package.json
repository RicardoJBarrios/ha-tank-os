{
  "name": "ha-tank-os",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for the ha-tank-os Home Assistant module.",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "lint:markdown": "markdownlint-cli2",
    "lint:planning": "node scripts/lint-planning-docs.mjs",
    "lint:spelling": "cspell --no-progress --no-summary \"AGENTS.md\" \"README.md\" \"docs/**/*.md\" \".github/**/*.md\" \"SECURITY.md\"",
    "lint:python": "ruff check .",
    "format:python:check": "ruff format --check .",
    "typecheck:python": "node scripts/run-python-quality.mjs typecheck",
    "lint:frontend": "eslint .",
    "format:frontend:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,css,scss,html}\"",
    "security:secrets": "gitleaks dir --config .gitleaks.toml --redact --no-banner .",
    "security:dependencies": "pnpm audit --audit-level=high",
    "security:python": "node scripts/run-python-quality.mjs security",
    "security:python:dependencies": "node scripts/run-python-quality.mjs dependencies",
    "security:python:test-environment": "pip-audit --progress-spinner off -r requirements-dev.txt",
    "ha:up": "docker compose -f compose.ha.yaml up -d",
    "ha:down": "docker compose -f compose.ha.yaml down",
    "ha:logs": "docker compose -f compose.ha.yaml logs -f homeassistant",
    "ha:status": "node scripts/ha-status.mjs",
    "ha:wait": "node scripts/ha-wait.mjs",
    "ha:mcp:status": "node scripts/ha-mcp-status.mjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:braces": "node --test tests/braces-depth.test.mjs",
    "test:e2e": "pnpm ha:wait && playwright test",
    "test:e2e:headed": "pnpm ha:wait && playwright test --headed",
    "test:e2e:ui": "pnpm ha:wait && playwright test --ui",
    "test:e2e:report": "playwright show-report artifacts/playwright/report",
    "sonarqube:up": "docker compose -f compose.sonar.yaml up -d",
    "sonarqube:status": "node scripts/sonarqube-status.mjs",
    "sonarqube:down": "docker compose -f compose.sonar.yaml down",
    "sonarqube:logs": "docker compose -f compose.sonar.yaml logs -f sonarqube",
    "validate:openspec": "openspec validate --all",
    "validate:readiness": "uv run python scripts/process-readiness.py",
    "context:validate": "uv run python scripts/context-resolver.py validate",
    "context:index": "uv run python scripts/context-resolver.py index",
    "context:search": "uv run python scripts/context-resolver.py search",
    "context:pack": "uv run python scripts/context-resolver.py pack",
    "agent:trace": "uv run python scripts/agent-trace.py",
    "agent:observability": "uv run python scripts/agent-observability.py",
    "agent:codex:self-test": "uv run python scripts/codex-runtime-self-test.py",
    "agent:health": "uv run python scripts/agent-health.py",
    "quality:checks": "pnpm test:python && pnpm test:braces && pnpm lint:markdown && pnpm lint:planning && pnpm lint:spelling && pnpm lint:python && pnpm format:python:check && pnpm typecheck:python && pnpm lint:frontend && pnpm format:frontend:check && pnpm security:dependencies && pnpm security:python && pnpm security:python:dependencies && pnpm validate:openspec && pnpm validate:readiness && git diff --check",
    "quality": "pnpm quality:checks && pnpm security:secrets"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.13.2",
    "@playwright/test": "1.63.0",
    "braces": "workspace:*",
    "cspell": "10.3.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9"
  }
}
